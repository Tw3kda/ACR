# =============================================================================
# ACR — API de consentimiento informado (Lambda + API Gateway HTTP API)
#
# Nada de esto es obligatorio para arrancar: sin variables, cada adaptador entra
# en modo simulado y el API responde igual. Cuando la infraestructura exista,
# basta rellenar el bloque correspondiente para que ese adaptador pase a AWS real.
#
# Ninguna variable de este archivo se lee en el navegador ni viaja a la app.
# NO copie aquí valores reales de producción: use Parameter Store / Secrets
# Manager y páselos a la función como variables de entorno del propio Lambda.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=acr-consent-api
PORT=3000
AWS_REGION=us-east-1

# Solo si el API se despliega bajo un stage nombrado (/prod/auth/login).
# Con el stage $default déjelo vacío.
API_STAGE_PREFIX=

# API Gateway corta en 10 MB y Lambda en 6 MB de payload síncrono.
JSON_BODY_LIMIT=6mb

# --- CORS (solo para `expo start --web`) -------------------------------------
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
CORS_ALLOWED_HEADERS=content-type,authorization,x-api-key
CORS_ALLOWED_METHODS=GET,POST,PUT,OPTIONS

# --- Rutas (deben coincidir con el .env de la app) ---------------------------
PATH_AUTH_LOGIN=/auth/login
PATH_AUTH_REGISTER=/auth/register
PATH_AUTH_REFRESH=/auth/refresh
PATH_AUDIT_LOGS=/audit/logs
PATH_CONSENTS=/consents
PATH_AUDIT_SEARCH=/audit/search
PATH_PATIENTS_TODAY=/patients/today
PATH_PATIENTS_SUGGEST=/patients/suggest
PATH_PDF_DOWNLOAD_URL=/consents/:consent_id/pdf-download-url
PATH_HEALTH=/health

# --- Salud -------------------------------------------------------------------
# /health es una ruta pública en el gateway. Con el detalle activado publica qué
# adaptador está activo y en qué entorno corre; por defecto solo fuera de
# producción. Actívelo temporalmente durante la Fase 3 para verificar el paso a
# AWS real, y vuelva a apagarlo.
HEALTH_DETAILED=

# --- Autorización ------------------------------------------------------------
# gateway = se confía en las claims que ya validó el JWT authorizer (producción).
# local   = se decodifica el Bearer sin verificar firma (solo desarrollo).
AUTH_CLAIMS_SOURCE=gateway
AUTH_ALLOW_LOCAL_CLAIMS=true

# Segunda barrera opcional de x-api-key. La cuota real la aplica el plan de uso
# del gateway; una API key dentro de una app móvil NO es un secreto.
API_KEY=
API_KEY_ENFORCED=false

# --- Cognito -----------------------------------------------------------------
# Con COGNITO_USER_POOL_ID + COGNITO_CLIENT_ID definidos, el driver pasa a `aws`.
COGNITO_DRIVER=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=
COGNITO_AUTH_FLOW=ADMIN_USER_PASSWORD_AUTH
# Debe coincidir con lo que valide el JWT authorizer: access | id
COGNITO_TOKEN_FOR_APP=access
# envelope | body | none — ver "Hallazgo 2" en docs/API_IMPLEMENTATION.md
COGNITO_REFRESH_USERNAME_MODE=
# El auto-registro abierto deja crear cuentas de personal clínico a cualquiera.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=
MIN_PASSWORD_LENGTH=8

# --- Registro de auditoría (S3 con Object Lock) ---------------------------------
# Con EVIDENCE_BUCKET definido, el driver pasa a `aws`. Cada consentimiento es
# una secuencia de objetos inmutables: events/<id>/0001-CONSENT_SIGNED.json,
# events/<id>/0002-PDF_VERIFIED.json, más tres punteros de índice en index/.
EVIDENCE_BUCKET=
EVIDENCE_DRIVER=
EVIDENCE_REGION=
EVIDENCE_ENDPOINT=
EVIDENCE_EVENTS_PREFIX=events
EVIDENCE_INDEX_PREFIX=index
AUDIT_ALLOWED_EVENT_TYPES=CONSENT_SIGNED,CONSENT_VIEWED,CONSENT_DECLINED,CONSENT_REVOKED
AUDIT_MAX_BIOMETRIC_POINTS=20000

# --- S3 ----------------------------------------------------------------------
PDF_BUCKET=
S3_DRIVER=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
PDF_KEY_PREFIX=consents
PDF_MAX_BYTES=4194304
PDF_SSE_KMS_KEY_ID=

# --- Traza de consola --------------------------------------------------------
# Imprime en bloques legibles lo que llega, lo que se responde y la llamada que
# se hará a AWS. Se enciende sola mientras algún adaptador esté simulado.
# Déjela apagada en producción: volcar cuerpos completos en CloudWatch es un
# problema de privacidad, no una ayuda.
TRACE_IO=
TRACE_BODY_MAX_CHARS=4000
# Oculta contraseñas y acorta tokens y URLs firmadas. TRACE_REDACT=false imprime
# los valores tal cual: solo en local.
TRACE_REDACT=true
# Sin recortar arreglos largos (los miles de puntos de la biometría).
TRACE_FULL=false
TRACE_COLORS=

# --- Modo simulado -----------------------------------------------------------
# Un despliegue con NODE_ENV=production y adaptadores simulados falla en frío,
# a propósito. Esta salida de emergencia debe usarse solo de forma consciente.
ALLOW_STUB_IN_PRODUCTION=false
STUB_SEED_EMAIL=demo@acrvitallaboral.com
STUB_SEED_PASSWORD=Demo1234!
STUB_SEED_NAME=Usuario Demo

# --- Web de consulta (WEB PDF CHECK/) -------------------------------------------
# Grupo de Cognito exigido en /audit/search y /consents/*/pdf-download-url.
# Vacío = cualquier usuario autenticado (por defecto fuera de producción).
AUTH_READER_GROUP=
# Vida de la URL firmada del PDF: es una autorización al portador.
PDF_DOWNLOAD_URL_TTL_SECONDS=60
AUDIT_SEARCH_MAX_ITEMS=200
EVIDENCE_ACCESS_PREFIX=access
# Con evidencia y S3 simulados, `npm start` crea consentimientos de ejemplo
# (cédulas 1018293847 y 79845123).
STUB_SEED_CONSENTS=true
