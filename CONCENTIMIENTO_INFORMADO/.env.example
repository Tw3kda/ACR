# ---------------------------------------------------------------------------
# API gateway
# ---------------------------------------------------------------------------
# Copy to `.env` (committed defaults) or `.env.local` (machine-specific, git
# ignored) and fill in. Everything here is EXPO_PUBLIC_*, which means it is
# inlined into the JS bundle in plain text — endpoints and the gateway's public
# API key belong here, signing credentials never do.
#
# EXPO_PUBLIC_API_URL is required: without it the app cannot log in. Print
# every request and response with EXPO_PUBLIC_API_LOG=true.

# Base URL of the API gateway, no trailing slash.
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
# Sent as `x-api-key` when the stage requires a key. Optional.
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Print every outbound payload and response. Defaults to on in development.
EXPO_PUBLIC_API_LOG=true

# Routes, relative to the base URL. `{consent_id}` is substituted per request,
# so a backend that routes differently needs a config change, not a code change.
EXPO_PUBLIC_AUTH_LOGIN_PATH=/auth/login
EXPO_PUBLIC_AUTH_REGISTER_PATH=/auth/register
EXPO_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh
EXPO_PUBLIC_CONSENTS_PATH=/consents
# Consent forms, downloaded from the backend (published with
# API GATEWAY/scripts/publish-template.mjs — see API GATEWAY/docs/PLANTILLAS.md).
EXPO_PUBLIC_TEMPLATES_PATH=/templates
EXPO_PUBLIC_TEMPLATE_PATH=/templates/{code}

# How long a session token lasts. Must match what Cognito issues; the app
# renews at 90% of this, and again whenever it returns to the foreground.
EXPO_PUBLIC_AUTH_TOKEN_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Deployment identity — stamped onto every audit log
# ---------------------------------------------------------------------------
EXPO_PUBLIC_CLINIC_LOCATION_ID=SEDE_NORTE_01
EXPO_PUBLIC_DEFAULT_ID_TYPE=CC
# Only a fallback: the exam type now comes from each form's `examType`.
EXPO_PUBLIC_MEDICAL_EXAM_TYPE=EXAMEN_INGRESO_OCUPACIONAL

# Where the backend parks the signed PDF. The app predicts the key
# (`<prefix>/<year>/<month>/<consent_id>.pdf`); the upload makes it real.
EXPO_PUBLIC_PDF_S3_BUCKET=medical-consent-pdfs-bucket
EXPO_PUBLIC_PDF_S3_PREFIX=consents
