# Committed defaults. EXPO_PUBLIC_API_URL is empty here on purpose: each
# machine sets its deployment in a git-ignored `.env.local`, which overrides
# this file. Without a URL the app reports a configuration error at login —
# it never simulates a backend.
#
# See .env.example for the full list and what each value means.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_API_LOG=true

EXPO_PUBLIC_AUTH_LOGIN_PATH=/auth/login
EXPO_PUBLIC_AUTH_REGISTER_PATH=/auth/register
EXPO_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh
EXPO_PUBLIC_CONSENTS_PATH=/consents
# Vigencia del token de sesión. Debe coincidir con lo que emite Cognito.
EXPO_PUBLIC_AUTH_TOKEN_TTL_HOURS=12

EXPO_PUBLIC_CLINIC_LOCATION_ID=SEDE_NORTE_01
EXPO_PUBLIC_DEFAULT_ID_TYPE=CC
EXPO_PUBLIC_MEDICAL_EXAM_TYPE=EXAMEN_INGRESO_OCUPACIONAL

EXPO_PUBLIC_PDF_S3_BUCKET=medical-consent-pdfs-bucket
EXPO_PUBLIC_PDF_S3_PREFIX=consents
